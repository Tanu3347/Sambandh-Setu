# ========================================================
# Sambandh Setu Backend Environment Configuration
# ========================================================

# Port for the Express server (Render sets PORT dynamically)
PORT=5000

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=production

# ========================================================
# Database Configuration (Neon DB / PostgreSQL or SQLite)
# ========================================================
# Option 1: Neon DB / PostgreSQL (Serverless cloud database - Recommended for production)
# 1. Sign up at https://neon.tech and create a free project
# 2. Copy the Connection String from the Neon dashboard
# 3. Paste it below as DATABASE_URL (or set it in Render Environment Variables)
DATABASE_URL=postgresql://neondb_owner:replace_with_neon_password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Option 2: SQLite database file path (Used automatically when DATABASE_URL is empty)
SQLITE_DB_PATH=sambandh_setu.db

# Authentication Secrets (minimum 32 characters for security)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Setu Guide AI Microservice URL (Deployed on Render as a Web Service)
# When deploying to production on Render, set this to your AI service URL:
# e.g., GUIDE_SERVICE_URL=https://sambandh-setu-ai.onrender.com
GUIDE_SERVICE_URL=https://sambandh-setu-ai.onrender.com

# CORS Configuration
# Set CORS_ALLOW_ALL=true and CORS_ALLOWED_ORIGINS=* to allow all web origins (Vercel SPA, local dev, mobile)
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=*

# Email Provider Configuration (Brevo / Sendinblue or placeholder)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=Sambandh Setu

# Rate Limiting Defaults
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=100
RATE_LIMIT_AUTH_IP_WINDOW_MS=3600000
RATE_LIMIT_AUTH_EMAIL_MAX=100
RATE_LIMIT_AUTH_EMAIL_WINDOW_MS=3600000

# Reverse Proxy Trust (Set to true on Render/Heroku/Fly.io behind reverse proxies)
TRUST_PROXY=true

# Error Monitoring (Optional - Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
