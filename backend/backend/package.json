    "test:integration": "node --test ./test/b1.integration.test.js",
    "test:b2": "node --test ./test/b2.test.js ./test/b2.integration.test.js",
    "test:b2:integration": "node --test ./test/b2.integration.test.js",
    "test:b3": "node --test ./test/b3.test.js",
    "test:b3:integration": "node --test ./test/b3.integration.test.js",
    "test:otp": "node --test ./test/otp.integration.test.js",
    "test:guide": "node --test ./test/guide.test.js ./test/guide.integration.test.js",
