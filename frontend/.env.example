# ========================================================
# Sambandh Setu Frontend Web & App Environment Configuration
# ========================================================

# Backend API Base URL (Deployed on Render as a Web Service)
# For local development: http://localhost:5000
# For production on Vercel: set to your Render backend service URL
EXPO_PUBLIC_API_URL=https://sambandh-setu-backend.onrender.com

# Set to false to use the live backend API
EXPO_PUBLIC_USE_MOCK=false

# Google OAuth Web Client ID (Optional)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
